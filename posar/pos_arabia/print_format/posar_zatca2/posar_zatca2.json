 "font_size": 14,
 "html": "<style>\n  .rtl {\n  direction: rtl;\n  unicode-bidi: embed;\n}\n\ntable.items th {\n  text-align: center;\n  vertical-align: middle;\n  line-height: 1.3;\n}\n\ntable.items th .small {\n  display: block;\n  font-size: 10px;\n  margin-top: 2px;\n}\n\n  table.items {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 12px;\n    border: 1px solid #000;\n  }\n\n  table.items th,\n  table.items td {\n    border: 1px solid #000;\n    padding: 6px 8px;\n    vertical-align: top;\n  }\n\n  table.items th {\n    background: #f5f5f5;\n    font-weight: bold;\n  }\n</style>\n\n<div style=\"text-align:center; margin-bottom:16px\">\n\n  <!-- Company Name -->\n  <h2 class=\"rtl\" style=\"margin:0\">\n    {{ doc.company }}\n  </h2>\n\n  <!-- VAT Number -->\n  <div class=\"small rtl\" style=\"margin-top:4px\">\n    \u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a:\n    <strong>{{ doc.company_tax_id }}</strong>\n  </div>\n\n  <!-- Invoice Title -->\n  <h3 style=\"margin-top:10px\">\n    Tax Invoice / <span class=\"rtl\">\u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629</span>\n  </h3>\n\n</div>\n\n\n<table style=\"width:100%; margin-top:12px; font-size:11px; border-collapse:collapse; border:1px solid #000\">\n\n  <tr>\n    <td style=\"width:50%; padding:6px; border:1px solid #000\">\n      <strong>Customer Name</strong><br>\n      <span class=\"small rtl\">\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644</span><br>\n      {{ doc.customer }}\n    </td>\n\n    <td style=\"width:50%; padding:6px; border:1px solid #000\">\n      <strong>Customer VAT No</strong><br>\n      <span class=\"small rtl\">\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a \u0644\u0644\u0639\u0645\u064a\u0644</span><br>\n      {{ doc.customer_tax_id or \"\u2014\" }}\n    </td>\n  </tr>\n\n  <tr>\n    <td style=\"padding:6px; border:1px solid #000\">\n      <strong>Invoice Number</strong><br>\n      <span class=\"small rtl\">\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</span><br>\n      {{ doc.name }}\n    </td>\n\n    <td style=\"padding:6px; border:1px solid #000\">\n      <strong>Issue Date (ISO 8601)</strong><br>\n      <span class=\"small rtl\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631</span><br>\n      {{ doc.posting_date }}T{{ frappe.utils.format_time(doc.posting_time, \"HH:mm:ss\") if doc.posting_time else \"00:00:00\" }}\n    </td>\n  </tr>\n\n</table>\n\n\n<table style=\"width:100%; margin-top:10px; font-size:10px;\">\n  <tr>\n    <td style=\"width:50%\">\n      <strong>UUID</strong><br>\n      {% if doc.get(\"custom_uuid\") %}\n        <span style=\"word-break:break-all\">\n          {{ doc.get(\"custom_uuid\") }}\n        </span>\n      {% else %}\n        <span style=\"color:#999\">Pending ZATCA clearance</span>\n      {% endif %}\n    </td>\n\n    <td style=\"width:50%\">\n      <strong>Invoice Hash</strong><br>\n      {% if doc.get(\"custom_zatca_invoice_hash\") %}\n        <span style=\"word-break:break-all\">\n          {{ doc.get(\"custom_zatca_invoice_hash\") }}\n        </span>\n      {% else %}\n        <span style=\"color:#999\">Pending ZATCA clearance</span>\n      {% endif %}\n    </td>\n  </tr>\n</table>\n\n<table class=\"items\">\n<thead>\n  <tr>\n    <th style=\"width:4%\">#</th>\n\n    <th style=\"width:36%\">\n      Description<br>\n      <span class=\"small rtl\">\u0627\u0644\u0648\u0635\u0641</span>\n    </th>\n\n    <th class=\"right\" style=\"width:8%\">\n      Qty<br>\n      <span class=\"small rtl\">\u0627\u0644\u0643\u0645\u064a\u0629</span>\n    </th>\n\n    <th class=\"right\" style=\"width:12%\">\n      Unit Price<br>\n      <span class=\"small rtl\">\u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</span>\n    </th>\n\n    <th class=\"right\" style=\"width:8%\">\n      VAT %<br>\n      <span class=\"small rtl\">\u0636\u0631\u064a\u0628\u0629 %</span>\n    </th>\n\n    <th class=\"right\" style=\"width:12%\">\n      VAT Amount<br>\n      <span class=\"small rtl\">\u0642\u064a\u0645\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</span>\n    </th>\n\n    <th class=\"right\" style=\"width:12%\">\n      Line Total<br>\n      <span class=\"small rtl\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</span>\n    </th>\n  </tr>\n</thead>\n\n  <tbody>\n    {% for row in doc.items %}\n    <tr>\n      <td>{{ loop.index }}</td>\n      <td>\n        {{ row.item_name }}\n        {% if row.custom_item_name_arabic %}\n        <div class=\"small rtl\">{{ row.custom_item_name_arabic }}</div>\n        {% endif %}\n      </td>\n      <td class=\"right\">{{ row.qty }}</td>\n      <td class=\"right\">{{ row.rate }}</td>\n      <td class=\"right\">{{ row.tax_rate or 15 }}</td>\n      <td class=\"right\">{{ row.tax_amount }}</td>\n      <td class=\"right\">{{ row.amount }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n</table>\n<table class=\"totals\" style=\"width:100%; margin-top:14px; border-collapse:collapse\">\n  <tr>\n    <!-- spacer column -->\n    <td style=\"width:60%\"></td>\n\n    <!-- totals column -->\n    <td style=\"width:40%\">\n      <table style=\"width:100%; border-collapse:collapse\">\n\n        <tr>\n          <td style=\"width:65%; padding:6px; border:1px solid #000\">\n            Net Amount<br>\n            <span class=\"small rtl\">\u0627\u0644\u0645\u0628\u0644\u063a \u0642\u0628\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</span>\n          </td>\n          <td class=\"right\" style=\"width:35%; padding:6px; border:1px solid #000\">\n            {{ \"%.2f\"|format(doc.net_total) }}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"width:65%; padding:6px; border:1px solid #000\">\n            Total VAT<br>\n            <span class=\"small rtl\">\u0625\u062c\u0645\u0627\u0644\u064a \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</span>\n          </td>\n          <td class=\"right\" style=\"width:35%; padding:6px; border:1px solid #000\">\n            {{ \"%.2f\"|format(doc.total_taxes_and_charges) }}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"width:65%; padding:6px; border:1px solid #000\">\n            <strong>Invoice Total</strong><br>\n            <span class=\"small rtl\"><strong>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</strong></span>\n          </td>\n          <td class=\"right\" style=\"width:35%; padding:6px; border:1px solid #000\">\n            <strong>{{ \"%.2f\"|format(doc.grand_total) }}</strong>\n          </td>\n        </tr>\n\n      </table>\n    </td>\n  </tr>\n</table>\n\n\n\n<div class=\"qr-block\">\n\n  <div>\n    {% if qr_file %}\n      <img src=\"{{ qr_file }}\" width=\"180\">\n    {% elif doc.get(\"custom_zatca_qr_png_path\") %}\n      <img src=\"{{ doc.get(\"custom_zatca_qr_png_path\") }}\" width=\"180\">\n    {% else %}\n      <div class=\"small\" style=\"color:#999\">\n        QR will be generated after ZATCA clearance\n      </div>\n    {% endif %}\n  </div>\n\n  <div>\n    <div class=\"small\"><strong>Cryptographic Stamp</strong></div>\n\n      {% if qr_file %}\n          <img src=\"{{ qr_file }}\" ><br>\n      {% elif doc.custom_zatca_qr_png_path %}\n          <img src=\"{{ doc.custom_zatca_qr_png_path }}\" ><br>\n      {% else %}\n          <p style=\"color: red; font-size: 12px;\">QR code not available<br>\u0631\u0645\u0632 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0627\u0644\u0633\u0631\u064a\u0639\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631</p>\n      {% endif %}\n  </div>\n\n</div>\n\n<div class=\"small\" style=\"margin-top:12px\">\n  This invoice is generated and cleared under ZATCA E-Invoicing Phase 2 regulations.\n</div>\n",
