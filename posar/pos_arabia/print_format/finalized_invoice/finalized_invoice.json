 "html": "<!-- ERPNext Print Format: Sales Invoice - ZATCA Phase 2 aware -->\n<!doctype html>\n<html>\n\n<head>\n  <meta charset=\"utf-8\" />\n  <title>Sales Invoice {{ doc.name }}</title>\n  <style>\n    body {\n      font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n      font-size: 12px;\n      color: #111;\n    }\n\n    .invoice-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      margin-bottom: 18px;\n    }\n\n    .company {\n      max-width: 60%;\n    }\n\n    .meta {\n      text-align: right;\n    }\n\n    table.items {\n      width: 100%;\n      border-collapse: collapse;\n      margin-top: 12px;\n    }\n\n    table.items th,\n    table.items td {\n      padding: 6px 8px;\n      border: 1px solid #ddd;\n      text-align: left;\n    }\n\n    .totals {\n      width: 100%;\n      margin-top: 12px;\n    }\n\n    .right {\n      text-align: right;\n    }\n\n    .small {\n      font-size: 11px;\n      color: #444;\n    }\n\n    .qr-block {\n      display: flex;\n      gap: 18px;\n      align-items: center;\n      margin-top: 18px;\n    }\n\n    .qr {\n      width: 180px;\n      height: 180px;\n      border: 1px solid #eee;\n      padding: 6px;\n    }\n\n    .stamp {\n      font-family: monospace;\n      word-break: break-all;\n      background: #f7f7f7;\n      padding: 8px;\n      border-radius: 4px;\n    }\n  </style>\n</head>\n\n<body>\n\n  <div class=\"invoice-header\">\n    <div class=\"company\">\n      <h2>{{ doc.company }}</h2>\n      <div class=\"small\">\n        {{ doc.company_address or frappe.get_value('Company', doc.company, 'address') }}<br />\n        VAT reg no: <strong>{{ doc.company_tax_id }}</strong><br />\n      </div>\n    </div>\n\n    <div class=\"meta\">\n      <h3>Tax Invoice \u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629</h3>\n      <div class=\"small\">\n        Invoice No: <strong>{{ doc.name }}</strong><br />\n        Date:\n        <strong>\n          {{ frappe.utils.format_date(doc.posting_date) }}\n          {% if doc.posting_time %}\n          {{ frappe.utils.format_time(doc.posting_time) }}\n          {% endif %}\n        </strong>\n        <br />\n        Customer: <strong>{{ doc.customer }}</strong><br />\n        Customer VAT: <strong>{{ doc.customer_tax_id or '' }}</strong>\n      </div>\n    </div>\n  </div>\n\n  <!-- Items -->\n  <table class=\"items\">\n    <thead>\n      <tr>\n        <th>#</th>\n        <th>Item</th>\n        <th class=\"right\">Qty</th>\n        <th class=\"right\">Unit Price</th>\n        <th class=\"right\">Line Total</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.items %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ row.item_name }}<div class=\"small\">{{ row.custom_item_name_arabic }}</div>\n        </td>\n        <td class=\"right\">{{ \"{:,.2f}\".format(row.qty) }}</td>\n        <td class=\"right\">{{ \"{:,.2f}\".format(row.rate) }}</td>\n        <td class=\"right\">{{ \"{:,.2f}\".format(row.amount) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <!-- Totals and tax break down -->\n  <table class=\"totals\">\n    <tr>\n      <td style=\"width:70%\"></td>\n      <td style=\"width:30%\">\n        <table style=\"width:100%\">\n          <tr>\n            <td class=\"small\">Net Total</td>\n            <td class=\"right\">{{ \"{:,.2f}\".format(doc.net_total) }}</td>\n          </tr>\n          <tr>\n            <td class=\"small\">Total Tax</td>\n            <td class=\"right\">{{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }}</td>\n          </tr>\n          <tr>\n            <td class=\"small\"><strong>Invoice Total</strong></td>\n            <td class=\"right\"><strong>{{ \"{:,.2f}\".format(doc.grand_total) }}</strong></td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n  {# ========================= QR CODE LOGIC ========================= #}\n  {% set qr_file = frappe.db.get_value(\n  \"File\",\n  {\n  \"attached_to_doctype\": \"Sales Invoice\",\n  \"attached_to_name\": doc.name,\n  \"file_name\": [\"like\", (\"QR_IMAGE_\" ~ doc.name ~ \"%\")]\n  },\n  \"file_url\"\n  ) %}\n  <!-- QR and Cryptographic stamp -->\n  <div class=\"qr-block\">\n    <div>\n      <!-- QR code image. Recommended: generate server side as data URI. Fallback below uses Google Charts -->\n      {% if qr_file %}\n      <img src=\"{{ qr_file }}\"><br>\n      {% elif doc.custom_zatca_qr_png_path %}\n      <img src=\"{{ doc.custom_zatca_qr_png_path }}\"><br>\n      {% else %}\n      <p style=\"color: red; font-size: 12px;\">QR code not available<br>\u0631\u0645\u0632 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0627\u0644\u0633\u0631\u064a\u0639\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631</p>\n      {% endif %}\n    </div>\n\n    <div>\n      <div class=\"small\"><strong>QR payload (Base64 TLV)</strong></div>\n      <span class=\"rtl\">\u062d\u0645\u0648\u0644\u0629 \u0631\u0645\u0632 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0627\u0644\u0633\u0631\u064a\u0639\u0629 (TLV Base64)</span>\n\n      <div style=\"margin-top:12px\" class=\"small\"><strong>Cryptographic Stamp / Hash</strong></div>\n      <div class=\"stamp\">{{ doc.custom_zatca_qr_code or \"None\" }}</div>\n\n      <div style=\"margin-top:8px\" class=\"small\">\n        Format: TLV Base64 with tags Seller name(1), VAT reg(2), Invoice timestamp(3), Invoice total(4), VAT total(5).\n      </div>\n      <div class=\"small\">Spec reference: ZATCA e-invoicing guides.</div>\n    </div>\n\n  </div>\n\n  <!-- Footer / Legal -->\n  <div style=\"margin-top:18px\" class=\"small\">\n    Note: This invoice follows ZATCA Phase 2 fields.\n  </div>\n\n</body>\n\n</html>",
